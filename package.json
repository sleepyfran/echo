{
  "name": "echo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "ci": "pnpm typecheck && pnpm lint && pnpm format",
    "dev": "vite",
    "build": "pnpm --filter @echo/web exec tsc && vite build --emptyOutDir",
    "format": "prettier --check \"packages/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"packages/**/*.{ts,tsx}\"",
    "gen": "pnpm exec plop",
    "lint": "pnpm -r run lint",
    "preview": "pnpm --filter @echo/web exec vite preview",
    "test": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "@types/node": "^20.12.12",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-wc": "^3.0.1",
    "husky": "~9.1.7",
    "plop": "^4.0.1",
    "prettier": "^3.6.2",
    "typescript": "5.8.3",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
