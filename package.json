{
  "name": "echo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "ci": "pnpm typecheck && pnpm lint && pnpm format",
    "dev": "vite",
    "build": "pnpm --filter @echo/web exec tsc && vite build --emptyOutDir",
    "format": "prettier --check \"packages/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"packages/**/*.{ts,tsx}\"",
    "gen": "pnpm exec plop",
    "lint": "pnpm -r run lint",
    "preview": "pnpm --filter @echo/web exec vite preview",
    "test": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^26.4.1",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.12.0",
    "husky": "~9.1.7",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
